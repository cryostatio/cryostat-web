{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:minimumReleaseAgeNpm",
    "docker:pinDigests",
    ":configMigration",
    ":docker",
    ":separateMajorReleases",
    ":separateMultipleMinorReleases",
    ":separatePatchReleases",
    ":pinVersions"
  ],
  "baseBranchPatterns": ["main", "/^cryostat-v.*/"],
  "reviewersFromCodeOwners": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": [
        "\"backendSchemaRef\": \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/cryostatio/cryostat",
      "depNameTemplate": "cryostatio/cryostat",
      "currentValueTemplate": "main"
    }
  ],
  "labels": ["dependencies", "chore", "safe-to-test"],
  "semanticCommits": "enabled",
  "major": {
    "dependencyDashboardApproval": true
  },
  "stopUpdatingLabel": "blocked",
  "packageRules": [
    {
      "description": "Disable all dependency updates on release branches except backendSchemaRef; other updates there are handled via Mergify backport",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "enabled": false
    },
    {
      "description": "Allow backendSchemaRef to update on release branches, tracking the matching cryostat release branch",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "matchPackageNames": ["https://github.com/cryostatio/cryostat"],
      "enabled": true
    },
    {
      "groupName": "react ecosystem",
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^react/",
        "/^@types/react/",
        "/^@testing-library/react/"
      ]
    },
    {
      "groupName": "patternfly",
      "dependencyDashboardApproval": true,
      "matchPackageNames": ["/^@patternfly//"]
    },
    {
      "groupName": "redux",
      "dependencyDashboardApproval": true,
      "matchPackageNames": ["/^@reduxjs//", "/^redux/", "/^react-redux/"]
    }
  ]
}
